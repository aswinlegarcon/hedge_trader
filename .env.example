# NIFTY Signal Lab — environment template (execution-v1)
# Copy to .env and fill in. NEVER commit .env. Live orders require Trade Ticket confirmation.

# ---- Upstox API (https://upstox.com/developer/api-documentation/) ----
# Spec 04: UPSTOX_ACCESS_TOKEN is required for Load/Refresh candles (read-only GET). Key/secret optional for now.
UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
UPSTOX_REDIRECT_URI=http://localhost:8501/Settings_and_API_Connections
# access_token from the official login flow — never paste into chat or Streamlit widgets.
UPSTOX_ACCESS_TOKEN=
# Optional separate token for sandbox order tests only (never falls back to live).
UPSTOX_SANDBOX_ACCESS_TOKEN=
UPSTOX_SANDBOX_ENABLED=
# Default 1 blocks live place/modify/cancel in automated tests; set 0 locally only if you accept live HTTP.
NSL_FORBID_LIVE_MUTATIONS=1

# ---- Application (execution-v1: ₹20,000 / ₹400 per position / ₹2,000 stop-new-risk) ----
# Legacy NSL_CAPITAL_INR / NSL_MAX_DRAWDOWN_INR / NSL_RISK_PER_TRADE_* override the revised profile
# and block funded-paper qualification until removed (values are never shown in the UI).
NSL_DB_PATH=data/journal.db
NSL_LOG_LEVEL=INFO

# ---- Spec 16: managed Upstox token ("Reconnect Upstox" in Settings) ----
# Installed server-side at data/secrets/upstox_token.json (mode 0600, gitignored); takes precedence over
# UPSTOX_ACCESS_TOKEN. UPSTOX_REDIRECT_URI must exactly equal the redirect URI registered for your Upstox app and
# must be a page of this dashboard (the Settings page receives the callback). When approving from another computer,
# open the dashboard through an SSH tunnel so "localhost:8501" resolves to this server. Optional path override:
# NSL_TOKEN_STORE=data/secrets/upstox_token.json
