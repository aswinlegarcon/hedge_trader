# NIFTY Signal Lab — environment template
# Copy to .env and fill in. NEVER commit .env. All broker access is READ-ONLY in v1.

# ---- Zerodha Kite Connect (https://developers.kite.trade) ----
# Paid subscription (₹500/month per app as of 2026-11, includes historical data).
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here
# access_token is obtained daily via the login flow; it expires at 06:00 IST next day.
# Leave blank; the app's Settings page explains the daily login procedure.
KITE_ACCESS_TOKEN=

# ---- Kotak Neo (https://github.com/Kotak-Neo/kotak-neo-python) ----
KOTAK_CONSUMER_KEY=your_kotak_consumer_key_here
KOTAK_CONSUMER_SECRET=your_kotak_consumer_secret_here
KOTAK_MOBILE=+91XXXXXXXXXX
# MPIN / TOTP are entered interactively at login time, never stored.

# ---- Application ----
NSL_CAPITAL_INR=100000
NSL_MAX_DRAWDOWN_INR=10000
NSL_RISK_PER_TRADE_MIN_INR=1000
NSL_RISK_PER_TRADE_MAX_INR=2000
NSL_DB_PATH=data/journal.db
NSL_LOG_LEVEL=INFO
